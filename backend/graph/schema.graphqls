# Core domain

enum Role { PARENT CHILD }

type User {
  id: ID!
  role: Role!
  name: String!
}

type Child {
  id: ID!
  familyId: ID!
  name: String!
  xp: Int!
  gold: Int!
}

type Quest {
  id: ID!
  familyId: ID!
  title: String!
  description: String
  xp: Int!
  gold: Int!
}

type Assignment {
  id: ID!
  quest: Quest!
  childId: ID!
  status: String!
  createdAt: String!
  completedAt: String
}

type Reward {
  id: ID!
  familyId: ID!
  name: String!
  xpThreshold: Int!
}

type Family {
  id: ID!
  name: String!
  ownerId: ID!
  createdAt: String!
}

type AvatarItem {
  id: ID!
  name: String!
  priceGold: Int!
}

type Query {
  health: String!

  # Parent-focused
  children(familyId: ID!): [Child!]!
  quests(familyId: ID!): [Quest!]!
  rewards(familyId: ID!): [Reward!]!
  family(id: ID!): Family
  families(ownerId: ID!): [Family!]!

  # Child-focused
  myAssignments(childId: ID!): [Assignment!]!

  # Billing
  subscriptionStatus(familyId: ID!): SubscriptionStatus!
}

input NewChild {
  familyId: ID!
  name: String!
}

input UpdateChildInput {
  name: String!
}

input NewQuest {
  familyId: ID!
  title: String!
  description: String
  xp: Int!
  gold: Int!
}

input NewReward {
  familyId: ID!
  name: String!
  xpThreshold: Int!
}

input NewFamily {
  ownerId: ID!
  name: String!
}

input UpdateQuestInput {
  title: String!
  description: String
  xp: Int!
  gold: Int!
}

input UpdateRewardInput {
  name: String!
  xpThreshold: Int!
}

type Mutation {
  # Parents
  createChild(input: NewChild!): Child!
  updateChild(familyId: ID!, childId: ID!, input: UpdateChildInput!): Child!
  deleteChild(familyId: ID!, childId: ID!): Boolean!
  createQuest(input: NewQuest!): Quest!
  assignQuest(familyId: ID!, questId: ID!, childId: ID!): Assignment!
  createReward(input: NewReward!): Reward!
  updateQuest(familyId: ID!, questId: ID!, input: UpdateQuestInput!): Quest!
  deleteQuest(familyId: ID!, questId: ID!): Boolean!
  updateReward(familyId: ID!, rewardId: ID!, input: UpdateRewardInput!): Reward!
  deleteReward(familyId: ID!, rewardId: ID!): Boolean!
  deleteFamily(familyId: ID!): Boolean!
  deleteAssignment(assignmentId: ID!): Boolean!
  createFamily(input: NewFamily!): Family!
  renameFamily(familyId: ID!, name: String!): Family!

  # Children
  completeAssignment(assignmentId: ID!): Assignment!
  purchaseItem(childId: ID!, itemName: String!, priceGold: Int!): Child!

  # Billing
  createCheckoutSession(familyId: ID!, successUrl: String!, cancelUrl: String!): String!
}

type SubscriptionStatus {
  active: Boolean!
  currentPeriodEnd: String
}
